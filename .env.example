# Discord Bot Token from Discord Developer Portal
TOKEN=your_discord_bot_token_here

# Bot Owners (Comma-separated Discord User IDs)
OWNERS="your_discord_user_id_here"

# Spotify Credentials (Optional, get free from developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Lavalink Server Configuration (Default / Primary)
LAVALINK_HOST="your_lavalink_host_here"
LAVALINK_PORT="2333"
LAVALINK_PASSWORD="your_lavalink_password_here"
LAVALINK_SECURE="false"

# Lavalink nodes (JSON array with multiple fallback nodes)
LAVALINK_NODES='[{"name":"Node-1","host":"your_lavalink_host_here","port":2333,"password":"your_lavalink_password_here","secure":false}]'
